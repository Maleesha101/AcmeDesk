# AcmeDesk Token Security Lab - Environment Configuration
# Copy to .env and adjust as needed

# Application
APP_NAME=AcmeDesk
APP_VERSION=1.0.0
DEBUG=true

# Database
POSTGRES_USER=acmedesk
POSTGRES_PASSWORD=acmedesk_lab_password
POSTGRES_DB=acmedesk
DATABASE_URL=postgresql+asyncpg://acmedesk:acmedesk_lab_password@db:5432/acmedesk

# Security
SECRET_KEY=lab_secret_key_change_in_production_32_chars_min
BCRYPT_ROUNDS=12

# Token Configuration
TOKEN_EXPIRY_MINUTES=15
TOKEN_SINGLE_USE=true

# Lab Configuration
LAB_MODE=true
LAB_INSTRUCTOR_MODE=false

# Rate Limiting (for /lab/generate-samples)
LAB_RATE_LIMIT_REQUESTS=5
LAB_RATE_LIMIT_WINDOW_SECONDS=60
LAB_MAX_SAMPLES_PER_REQUEST=500

# Frontend
FRONTEND_URL=http://localhost:8080

# Logging
LOG_LEVEL=INFO